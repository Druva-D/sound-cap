{
  "id": "./",
  "name": "Soundcap — your listening capsule",
  "short_name": "Soundcap",
  "description": "Daily listening minutes, top songs, artists and genres from your Spotify account.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
